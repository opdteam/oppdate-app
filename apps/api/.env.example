# --- SERVER ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- DATABASE ---
# Local development (Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oppdate

# Production (Neon) -- swap in for production
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/oppdate?sslmode=require

# --- REDIS (BullMQ background jobs) ---
REDIS_URL=redis://localhost:6379

# --- AUTH ---
JWT_SECRET=your-super-secret-jwt-key-change-this-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- FILE STORAGE (Cloudflare R2) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=oppdate-files
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://files.oppdate.com

# --- PAYMENTS ---
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_PREMIUM_MONTHLY_GENERAL=price_xxxx
STRIPE_PRICE_PREMIUM_YEARLY_GENERAL=price_xxxx
STRIPE_PRICE_PREMIUM_MONTHLY_REGIONAL=price_xxxx
STRIPE_PRICE_PREMIUM_YEARLY_REGIONAL=price_xxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx
PAYSTACK_SECRET_KEY=sk_test_xxxx
# Note: Paystack uses the secret key for webhook HMAC verification (no separate webhook secret)

# --- AI (OpenAI) ---
OPENAI_API_KEY=sk-proj-xxxx
OPENAI_ELIGIBILITY_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- EMAIL (Resend) ---
RESEND_API_KEY=re_xxxx
EMAIL_FROM=OppDate <noreply@oppdate.com>
SUPPORT_EMAIL=support@oppdate.com

# --- ERROR TRACKING (Sentry) ---
SENTRY_DSN=

# --- ENCRYPTION ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# --- RATE LIMITING ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

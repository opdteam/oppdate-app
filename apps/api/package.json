{
  "name": "@oppdate/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-admin": "tsx src/db/seed-admin.ts",
    "db:seed-mentorship-programmes": "tsx src/scripts/seed-mentorship-programmes.ts",
    "db:seed-consultation-pricing": "tsx src/scripts/seed-consultation-pricing.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@fastify/cookie": "9",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@neondatabase/serverless": "^0.9.3",
    "@oppdate/types": "*",
    "@sentry/node": "^10.73.0",
    "argon2": "^0.40.1",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.27.0",
    "fastify-raw-body": "4.3.0",
    "geoip-lite": "^2.0.3",
    "ioredis": "^6.0.0",
    "openai": "^4.52.1",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "stripe": "^15.12.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.21.4",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}

# OppDate Web -- Environment Variables
# Copy to .env.local and fill in values

# API
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (public key only -- secret key stays on the API)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Flutterwave (public key only)
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-...

# Paystack (public key only)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Feature flags
NEXT_PUBLIC_ENABLE_AI_CHAT=false
NEXT_PUBLIC_ENABLE_MENTORSHIP=false
NEXT_PUBLIC_ENABLE_EBOOKS=false
